// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  SUPER_ADMIN
  SALON_OWNER
  MANAGER
  RECEPTIONIST
  STAFF
}

enum SalonStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
  INACTIVE
}

enum BranchStatus {
  ACTIVE
  INACTIVE
  CLOSED
}

enum StaffStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  NO_SHOW
}

enum BookingSource {
  ONLINE
  ADMIN
  WALK_IN
  PHONE
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

enum LeaveType {
  ANNUAL
  SICK
  PERSONAL
  EMERGENCY
  OTHER
}

enum ClosureType {
  WEEKLY_OFF
  PUBLIC_HOLIDAY
  SPECIAL_HOLIDAY
  EMERGENCY_CLOSURE
  MAINTENANCE
  OTHER
}

enum NotificationType {
  BOOKING_CREATED
  BOOKING_CONFIRMED
  BOOKING_REJECTED
  BOOKING_CANCELLED
  BOOKING_RESCHEDULED
  APPOINTMENT_REMINDER
  BRANCH_CLOSURE
  APPOINTMENT_COMPLETED
  GENERAL
}

enum SubscriptionPlan {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  TRIAL
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
}

// ============================================================
// CORE USER MODELS
// ============================================================

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  phone     String?
  role      UserRole @default(STAFF)
  image     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  ownedSalons   Salon[]        @relation("SalonOwner")
  staffProfile  Staff?
  notifications Notification[] @relation("UserNotifications")
  auditLogs     AuditLog[]

  @@index([email])
  @@index([role])
}

// ============================================================
// SALON MODELS
// ============================================================

model Salon {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String?
  logo        String?
  website     String?
  email       String?
  phone       String?
  address     String?
  province    String?
  district    String?
  city        String?
  area        String?
  postalCode  String?
  country     String      @default("Sri Lanka")
  timezone    String      @default("Asia/Colombo")
  currency    String      @default("LKR")
  status      SalonStatus @default(PENDING)

  // Social links stored as JSON
  socialLinks Json?

  // Settings stored as JSON
  settings Json? // bookingInterval, cancellationWindow, requireOtp, autoConfirm, etc.

  // Owner
  ownerId String
  owner   User   @relation("SalonOwner", fields: [ownerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  branches          Branch[]
  staff             Staff[]
  serviceCategories ServiceCategory[]
  services          Service[]
  customers         Customer[]
  bookings          Booking[]
  coupons           Coupon[]
  subscription      SalonSubscription?
  notifications     Notification[]

  // Phase 1: business operations
  expenseCategories ExpenseCategory[]
  expenses          Expense[]
  recurringExpenses RecurringExpense[]
  storedFiles       StoredFile[]
  productCategories ProductCategory[]
  products          Product[]
  suppliers         Supplier[]
  sales             Sale[]

  @@index([ownerId])
  @@index([status])
  @@index([slug])
}

model SalonSubscription {
  id        String             @id @default(cuid())
  salonId   String             @unique
  salon     Salon              @relation(fields: [salonId], references: [id])
  plan      SubscriptionPlan   @default(FREE)
  status    SubscriptionStatus @default(TRIAL)
  startDate DateTime           @default(now())
  endDate   DateTime?
  amount    Float              @default(0)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

// ============================================================
// BRANCH MODELS
// ============================================================

model Branch {
  id         String       @id @default(cuid())
  salonId    String
  salon      Salon        @relation(fields: [salonId], references: [id])
  name       String
  address    String?
  phone      String?
  email      String?
  province   String?
  district   String?
  city       String?
  area       String?
  postalCode String?
  latitude   Float?
  longitude  Float?
  status     BranchStatus @default(ACTIVE)
  timezone   String       @default("Asia/Colombo")

  // Booking settings
  bookingInterval Int @default(30) // minutes
  minNoticeHours  Int @default(1)
  maxAdvanceDays  Int @default(30)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  schedules     BranchSchedule[]
  closures      BranchClosure[]
  staff         Staff[]          @relation("StaffBranch")
  staffBranches StaffBranch[]
  services      BranchService[]
  bookings      Booking[]
  notifications Notification[]

  // Phase 1: business operations
  expenses          Expense[]
  recurringExpenses RecurringExpense[]
  stockLevels       StockLevel[]
  stockBatches      StockBatch[]
  stockMovements    StockMovement[]
  purchaseOrders    PurchaseOrder[]
  goodsReceipts     GoodsReceipt[]
  transfersOut      StockTransfer[]    @relation("TransferFrom")
  transfersIn       StockTransfer[]    @relation("TransferTo")
  sales             Sale[]
  commissionRules   CommissionRule[]
  commissionEntries CommissionEntry[]
  payrollRecords    PayrollRecord[]

  @@index([salonId])
  @@index([status])
  @@index([district])
  @@index([city])
}

model BranchSchedule {
  id        String  @id @default(cuid())
  branchId  String
  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  dayOfWeek Int // 0=Sunday, 1=Monday, ..., 6=Saturday
  isOpen    Boolean @default(true)

  // Stored as HH:MM format
  openTime  String @default("09:00")
  closeTime String @default("18:00")

  // Break time
  hasBreak   Boolean @default(false)
  breakStart String? // HH:MM
  breakEnd   String? // HH:MM

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, dayOfWeek])
  @@index([branchId])
}

model BranchClosure {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  salonId  String // Denormalized for query performance

  closureType ClosureType @default(OTHER)
  reason      String?

  // Full day or partial
  isFullDay Boolean  @default(true)
  date      DateTime // The closure date (date only)

  // For partial closure
  startTime String? // HH:MM
  endTime   String? // HH:MM

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([salonId])
  @@index([date])
}

// ============================================================
// STAFF MODELS
// ============================================================

model Staff {
  id              String  @id @default(cuid())
  userId          String? @unique
  user            User?   @relation(fields: [userId], references: [id])
  salonId         String
  salon           Salon   @relation(fields: [salonId], references: [id])
  primaryBranchId String?
  primaryBranch   Branch? @relation("StaffBranch", fields: [primaryBranchId], references: [id])

  name           String
  email          String?
  phone          String?
  gender         String?
  photo          String?
  specialization String?
  bio            String?
  status         StaffStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  branches        StaffBranch[]
  schedules       StaffSchedule[]
  leaves          StaffLeave[]
  breaks          StaffBreak[]
  services        StaffService[]
  bookings        Booking[]
  bookingServices BookingService[]

  // Phase 1: payroll & commissions
  compensation      StaffCompensation?
  advances          StaffAdvance[]
  payrollRecords    PayrollRecord[]
  commissionRules   CommissionRule[]
  commissionEntries CommissionEntry[]

  @@index([salonId])
  @@index([primaryBranchId])
  @@index([status])
}

model StaffBranch {
  id        String   @id @default(cuid())
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([staffId, branchId])
  @@index([staffId])
  @@index([branchId])
}

model StaffSchedule {
  id        String   @id @default(cuid())
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  dayOfWeek Int // 0=Sunday...6=Saturday
  isWorking Boolean  @default(true)
  startTime String   @default("09:00") // HH:MM
  endTime   String   @default("18:00") // HH:MM
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([staffId, dayOfWeek])
  @@index([staffId])
}

model StaffLeave {
  id        String    @id @default(cuid())
  staffId   String
  staff     Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  salonId   String // Denormalized
  leaveType LeaveType @default(OTHER)
  reason    String?

  isFullDay Boolean  @default(true)
  startDate DateTime // Date part only
  endDate   DateTime // Date part only (same as startDate for single day)

  // For partial leave
  startTime String? // HH:MM
  endTime   String? // HH:MM

  approved   Boolean @default(false)
  approvedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([staffId])
  @@index([salonId])
  @@index([startDate])
}

model StaffBreak {
  id          String   @id @default(cuid())
  staffId     String
  staff       Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  dayOfWeek   Int // 0-6, or -1 for all days
  startTime   String // HH:MM
  endTime     String // HH:MM
  isRecurring Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([staffId])
}

// ============================================================
// SERVICE MODELS
// ============================================================

model ServiceCategory {
  id          String   @id @default(cuid())
  salonId     String
  salon       Salon    @relation(fields: [salonId], references: [id])
  name        String
  description String?
  image       String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  services Service[]

  @@index([salonId])
}

model Service {
  id         String          @id @default(cuid())
  salonId    String
  salon      Salon           @relation(fields: [salonId], references: [id])
  categoryId String
  category   ServiceCategory @relation(fields: [categoryId], references: [id])

  name        String
  description String?
  image       String?

  // Default price and duration
  price      Float @default(0)
  duration   Int   @default(30) // minutes
  bufferTime Int   @default(0) // minutes after service

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  branchServices  BranchService[]
  staffServices   StaffService[]
  bookingServices BookingService[]

  // Phase 1: inventory & commissions
  productUsages   ServiceProduct[]
  commissionRules CommissionRule[]

  @@index([salonId])
  @@index([categoryId])
}

model BranchService {
  id        String  @id @default(cuid())
  branchId  String
  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  // Branch-specific price override
  price    Float? // null means use service default
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, serviceId])
  @@index([branchId])
  @@index([serviceId])
}

model StaffService {
  id        String   @id @default(cuid())
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([staffId, serviceId])
  @@index([staffId])
  @@index([serviceId])
}

// ============================================================
// CUSTOMER MODELS
// ============================================================

model Customer {
  id      String @id @default(cuid())
  salonId String
  salon   Salon  @relation(fields: [salonId], references: [id])

  name        String
  phone       String
  email       String?
  gender      String?
  dateOfBirth DateTime?
  notes       String? // Customer notes visible to staff

  // Stats (denormalized for performance)
  totalBookings Int   @default(0)
  totalSpent    Float @default(0)
  noShowCount   Int   @default(0)
  cancelCount   Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  bookings       Booking[]
  loyaltyAccount LoyaltyAccount?
  reviews        Review[]
  sales          Sale[]

  @@unique([salonId, phone])
  @@index([salonId])
  @@index([phone])
}

// ============================================================
// BOOKING MODELS
// ============================================================

model Booking {
  id        String @id @default(cuid())
  reference String @unique // SAL-20260924-00001

  salonId    String
  salon      Salon    @relation(fields: [salonId], references: [id])
  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id])
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  staffId    String
  staff      Staff    @relation(fields: [staffId], references: [id])

  // Booking time
  bookingDate DateTime // Date of appointment
  startTime   String // HH:MM
  endTime     String // HH:MM

  // Status
  status BookingStatus @default(PENDING)
  source BookingSource @default(ONLINE)

  // Rejection/cancellation
  rejectionReason    String?
  cancellationReason String?

  // Notes
  customerNotes String? // Visible to customer and staff
  staffNotes    String? // Internal only

  // Financial
  subtotal       Float         @default(0)
  discountAmount Float         @default(0)
  taxAmount      Float         @default(0)
  totalAmount    Float         @default(0)
  depositAmount  Float         @default(0)
  paidAmount     Float         @default(0)
  paymentStatus  PaymentStatus @default(UNPAID)

  // Coupon
  couponId String?
  coupon   Coupon? @relation(fields: [couponId], references: [id])

  // Timestamps
  confirmedAt  DateTime?
  checkedInAt  DateTime?
  inProgressAt DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  services      BookingService[]
  statusHistory BookingStatusHistory[]
  payments      Payment[]
  invoice       Invoice?
  review        Review?
  notifications Notification[]

  // Phase 1
  sales             Sale[]
  consumption       BookingConsumption?
  commissionEntries CommissionEntry[]

  @@index([salonId])
  @@index([branchId])
  @@index([staffId])
  @@index([customerId])
  @@index([bookingDate])
  @@index([status])
  @@index([reference])
}

model BookingService {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])
  staffId   String
  staff     Staff   @relation(fields: [staffId], references: [id])

  price      Float @default(0)
  duration   Int   @default(30) // minutes
  bufferTime Int   @default(0)

  createdAt DateTime @default(now())

  @@index([bookingId])
  @@index([serviceId])
}

model BookingStatusHistory {
  id        String        @id @default(cuid())
  bookingId String
  booking   Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  status    BookingStatus
  changedBy String? // User ID
  reason    String?
  notes     String?
  createdAt DateTime      @default(now())

  @@index([bookingId])
}

// ============================================================
// PAYMENT & INVOICE MODELS
// ============================================================

model Payment {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id])
  salonId   String

  amount    Float
  method    String  @default("CASH") // CASH, CARD, ONLINE
  reference String? // External payment reference
  notes     String?
  status    String  @default("COMPLETED")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([salonId])
}

model Invoice {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique
  // Appointment invoices set bookingId; POS product-sale invoices set saleId.
  bookingId     String?  @unique
  booking       Booking? @relation(fields: [bookingId], references: [id])
  saleId        String?  @unique
  sale          Sale?    @relation(fields: [saleId], references: [id])
  salonId       String

  subtotal       Float @default(0)
  discountAmount Float @default(0)
  taxAmount      Float @default(0)
  totalAmount    Float @default(0)
  paidAmount     Float @default(0)
  balanceAmount  Float @default(0)

  issuedAt DateTime  @default(now())
  dueDate  DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([salonId])
  @@index([bookingId])
}

// ============================================================
// COUPON & LOYALTY MODELS
// ============================================================

model Coupon {
  id      String @id @default(cuid())
  salonId String
  salon   Salon  @relation(fields: [salonId], references: [id])

  code        String
  name        String
  description String?

  type  CouponType @default(PERCENTAGE)
  value Float // Percentage or fixed amount

  minBookingValue Float?
  maxDiscount     Float?

  // Restrictions
  specificBranchId  String?
  specificServiceId String?
  newCustomersOnly  Boolean @default(false)

  // Validity
  startDate        DateTime?
  endDate          DateTime?
  maxUsage         Int? // Total uses allowed
  perCustomerLimit Int? // Uses per customer

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  usages   CouponUsage[]
  bookings Booking[]

  @@unique([salonId, code])
  @@index([salonId])
}

model CouponUsage {
  id         String   @id @default(cuid())
  couponId   String
  coupon     Coupon   @relation(fields: [couponId], references: [id])
  customerId String
  bookingId  String?
  usedAt     DateTime @default(now())

  @@index([couponId])
  @@index([customerId])
}

model LoyaltyAccount {
  id         String   @id @default(cuid())
  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id])
  salonId    String

  totalPoints Int @default(0)
  usedPoints  Int @default(0)
  balance     Int @default(0) // totalPoints - usedPoints

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions LoyaltyTransaction[]

  @@index([salonId])
}

model LoyaltyTransaction {
  id        String         @id @default(cuid())
  accountId String
  account   LoyaltyAccount @relation(fields: [accountId], references: [id])

  points      Int // Positive = earned, Negative = used
  description String?
  bookingId   String?

  createdAt DateTime @default(now())

  @@index([accountId])
}

// ============================================================
// REVIEW MODEL
// ============================================================

model Review {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  booking    Booking  @relation(fields: [bookingId], references: [id])
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  salonId    String
  staffId    String?

  salonRating   Int // 1-5
  staffRating   Int? // 1-5
  serviceRating Int? // 1-5

  comment String?

  isPublished Boolean @default(true)
  isModerated Boolean @default(false)
  moderatedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([salonId])
  @@index([customerId])
  @@index([staffId])
}

// ============================================================
// NOTIFICATION MODEL
// ============================================================

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation("UserNotifications", fields: [userId], references: [id])
  salonId   String?
  salon     Salon?   @relation(fields: [salonId], references: [id])
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id])

  type    NotificationType @default(GENERAL)
  title   String
  message String
  data    Json? // Additional data for the notification

  isRead Boolean   @default(false)
  readAt DateTime?

  // Channels
  sentEmail Boolean @default(false)
  sentSms   Boolean @default(false)
  sentPush  Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([salonId])
  @@index([bookingId])
  @@index([isRead])
}

// ============================================================
// AUDIT LOG MODEL
// ============================================================

model AuditLog {
  id      String  @id @default(cuid())
  userId  String?
  user    User?   @relation(fields: [userId], references: [id])
  salonId String?

  action   String // e.g., "SALON_APPROVED", "BOOKING_CONFIRMED"
  entity   String // e.g., "Salon", "Booking"
  entityId String?

  oldData  Json?
  newData  Json?
  metadata Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([salonId])
  @@index([action])
  @@index([createdAt])
}

// ============================================================
// PHASE 1: BUSINESS OPERATIONS
// All money columns use DECIMAL (never Float). Quantities use DECIMAL(14,3).
// ============================================================

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  VOIDED
}

enum ExpensePaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  OTHER
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

enum StockMovementType {
  PURCHASE_RECEIPT
  MANUAL_IN
  MANUAL_OUT
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  SALE
  SALE_RETURN
  SERVICE_CONSUMPTION
  CONSUMPTION_REVERSAL
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum SaleStatus {
  COMPLETED
  PARTIALLY_REFUNDED
  REFUNDED
  VOIDED
}

enum CommissionType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum CommissionSource {
  SERVICE
  PRODUCT
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  VOIDED
}

enum SalaryType {
  FIXED_MONTHLY
  DAILY
  HOURLY
  COMMISSION_ONLY
  BASIC_PLUS_COMMISSION
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
  VOIDED
}

enum PayrollAdjustmentType {
  BONUS
  DEDUCTION
}

enum AdvanceStatus {
  OUTSTANDING
  RECOVERED
  VOIDED
}

enum PeriodStatus {
  OPEN
  CLOSED
}

// ---------- Shared ----------

// Binary files (expense receipts, product images) are stored in the database and
// only ever served through authenticated, tenant-checked API routes.
model StoredFile {
  id           String   @id @default(cuid())
  salonId      String
  salon        Salon    @relation(fields: [salonId], references: [id])
  kind         String // EXPENSE_RECEIPT | PRODUCT_IMAGE
  fileName     String
  mimeType     String
  size         Int
  data         Bytes
  uploadedById String?
  createdAt    DateTime @default(now())

  expenseAttachments ExpenseAttachment[]

  @@index([salonId, kind])
}

// Atomic per-salon document numbering (sales, POs, receipts, transfers, payslips)
model DocumentSequence {
  id        String @id @default(cuid())
  salonId   String
  kind      String
  lastValue Int    @default(0)

  @@unique([salonId, kind])
}

// ---------- Expenses ----------

model ExpenseCategory {
  id          String   @id @default(cuid())
  salonId     String
  salon       Salon    @relation(fields: [salonId], references: [id])
  name        String
  description String?
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  expenses          Expense[]
  recurringExpenses RecurringExpense[]

  @@unique([salonId, name])
  @@index([salonId])
}

model Expense {
  id         String          @id @default(cuid())
  salonId    String
  salon      Salon           @relation(fields: [salonId], references: [id])
  branchId   String
  branch     Branch          @relation(fields: [branchId], references: [id])
  categoryId String
  category   ExpenseCategory @relation(fields: [categoryId], references: [id])

  description   String
  referenceNo   String?
  amount        Decimal              @db.Decimal(14, 2)
  expenseDate   DateTime
  paymentMethod ExpensePaymentMethod @default(CASH)
  status        ExpenseStatus        @default(PENDING)
  notes         String?

  createdById     String
  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?
  voidedById      String?
  voidedAt        DateTime?
  voidReason      String?
  // Soft delete: deleted expenses are never part of financial totals
  deletedAt       DateTime?
  deletedById     String?

  recurringExpenseId String?
  recurringExpense   RecurringExpense? @relation(fields: [recurringExpenseId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachments ExpenseAttachment[]

  @@unique([recurringExpenseId, expenseDate])
  @@index([salonId, expenseDate])
  @@index([branchId, expenseDate])
  @@index([categoryId])
  @@index([status])
}

model ExpenseAttachment {
  id        String     @id @default(cuid())
  expenseId String
  expense   Expense    @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  fileId    String
  file      StoredFile @relation(fields: [fileId], references: [id])
  fileName  String
  mimeType  String
  size      Int
  createdAt DateTime   @default(now())

  @@index([expenseId])
}

model RecurringExpense {
  id            String               @id @default(cuid())
  salonId       String
  salon         Salon                @relation(fields: [salonId], references: [id])
  branchId      String
  branch        Branch               @relation(fields: [branchId], references: [id])
  categoryId    String
  category      ExpenseCategory      @relation(fields: [categoryId], references: [id])
  description   String
  amount        Decimal              @db.Decimal(14, 2)
  paymentMethod ExpensePaymentMethod @default(CASH)
  frequency     RecurrenceFrequency  @default(MONTHLY)
  startDate     DateTime
  endDate       DateTime?
  nextRunDate   DateTime
  lastRunAt     DateTime?
  autoApprove   Boolean              @default(false)
  isActive      Boolean              @default(true)
  createdById   String
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  expenses Expense[]

  @@index([salonId, isActive, nextRunDate])
}

// ---------- Inventory ----------

model ProductCategory {
  id        String   @id @default(cuid())
  salonId   String
  salon     Salon    @relation(fields: [salonId], references: [id])
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@unique([salonId, name])
  @@index([salonId])
}

model Product {
  id           String           @id @default(cuid())
  salonId      String
  salon        Salon            @relation(fields: [salonId], references: [id])
  categoryId   String?
  category     ProductCategory? @relation(fields: [categoryId], references: [id])
  name         String
  description  String?
  brand        String?
  sku          String
  barcode      String?
  unit         String           @default("pcs")
  costPrice    Decimal          @default(0) @db.Decimal(14, 2)
  sellingPrice Decimal          @default(0) @db.Decimal(14, 2)
  taxRate      Decimal          @default(0) @db.Decimal(5, 2)
  minStock     Decimal          @default(0) @db.Decimal(14, 3)
  imageFileId  String?
  trackBatches Boolean          @default(false)
  isActive     Boolean          @default(true)
  archivedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  stockLevels      StockLevel[]
  stockBatches     StockBatch[]
  stockMovements   StockMovement[]
  serviceUsages    ServiceProduct[]
  poItems          PurchaseOrderItem[]
  receiptItems     GoodsReceiptItem[]
  transferItems    StockTransferItem[]
  saleItems        SaleItem[]
  commissionRules  CommissionRule[]
  consumptionItems BookingConsumptionItem[]

  @@unique([salonId, sku])
  @@unique([salonId, barcode])
  @@index([salonId, isActive])
  @@index([categoryId])
}

model Supplier {
  id            String   @id @default(cuid())
  salonId       String
  salon         Salon    @relation(fields: [salonId], references: [id])
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  notes         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]

  @@index([salonId])
}

// Current on-hand balance per product per branch. Only changed through
// src/lib/inventory.ts, which always writes a matching StockMovement.
model StockLevel {
  id        String   @id @default(cuid())
  salonId   String
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id])
  quantity  Decimal  @default(0) @db.Decimal(14, 3)
  // Weighted moving-average unit cost, used for COGS and valuation
  avgCost   Decimal  @default(0) @db.Decimal(14, 4)
  updatedAt DateTime @updatedAt

  @@unique([productId, branchId])
  @@index([branchId])
  @@index([salonId])
}

model StockBatch {
  id          String    @id @default(cuid())
  salonId     String
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  branchId    String
  branch      Branch    @relation(fields: [branchId], references: [id])
  batchNumber String?
  expiryDate  DateTime?
  quantity    Decimal   @db.Decimal(14, 3) // remaining quantity
  unitCost    Decimal   @default(0) @db.Decimal(14, 4)
  receivedAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())

  movements StockMovement[]

  @@index([productId, branchId])
  @@index([expiryDate])
}

model StockMovement {
  id            String            @id @default(cuid())
  salonId       String
  branchId      String
  branch        Branch            @relation(fields: [branchId], references: [id])
  productId     String
  product       Product           @relation(fields: [productId], references: [id])
  batchId       String?
  batch         StockBatch?       @relation(fields: [batchId], references: [id])
  type          StockMovementType
  quantity      Decimal           @db.Decimal(14, 3) // signed: + in, - out
  balanceAfter  Decimal           @db.Decimal(14, 3)
  unitCost      Decimal?          @db.Decimal(14, 4)
  referenceType String? // SALE | PURCHASE_ORDER | GOODS_RECEIPT | TRANSFER | BOOKING | MANUAL
  referenceId   String?
  reason        String?
  createdById   String?
  createdAt     DateTime          @default(now())

  @@index([salonId, createdAt])
  @@index([branchId, productId])
  @@index([referenceType, referenceId])
}

model PurchaseOrder {
  id           String              @id @default(cuid())
  salonId      String
  branchId     String
  branch       Branch              @relation(fields: [branchId], references: [id])
  supplierId   String
  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  poNumber     String
  status       PurchaseOrderStatus @default(DRAFT)
  orderDate    DateTime            @default(now())
  expectedDate DateTime?
  notes        String?
  subtotal     Decimal             @default(0) @db.Decimal(14, 2)
  taxAmount    Decimal             @default(0) @db.Decimal(14, 2)
  totalAmount  Decimal             @default(0) @db.Decimal(14, 2)
  createdById  String
  orderedAt    DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  items    PurchaseOrderItem[]
  receipts GoodsReceipt[]

  @@unique([salonId, poNumber])
  @@index([salonId, status])
  @@index([supplierId])
  @@index([branchId])
}

model PurchaseOrderItem {
  id               String        @id @default(cuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product       @relation(fields: [productId], references: [id])
  quantityOrdered  Decimal       @db.Decimal(14, 3)
  quantityReceived Decimal       @default(0) @db.Decimal(14, 3)
  unitCost         Decimal       @db.Decimal(14, 2)
  taxRate          Decimal       @default(0) @db.Decimal(5, 2)

  receiptItems GoodsReceiptItem[]

  @@index([purchaseOrderId])
}

model GoodsReceipt {
  id                String         @id @default(cuid())
  salonId           String
  branchId          String
  branch            Branch         @relation(fields: [branchId], references: [id])
  supplierId        String?
  supplier          Supplier?      @relation(fields: [supplierId], references: [id])
  purchaseOrderId   String?
  purchaseOrder     PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  receiptNumber     String
  receivedAt        DateTime       @default(now())
  supplierInvoiceNo String?
  notes             String?
  totalCost         Decimal        @default(0) @db.Decimal(14, 2)
  receivedById      String
  createdAt         DateTime       @default(now())

  items GoodsReceiptItem[]

  @@unique([salonId, receiptNumber])
  @@index([salonId, receivedAt])
  @@index([purchaseOrderId])
}

model GoodsReceiptItem {
  id          String             @id @default(cuid())
  receiptId   String
  receipt     GoodsReceipt       @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  productId   String
  product     Product            @relation(fields: [productId], references: [id])
  poItemId    String?
  poItem      PurchaseOrderItem? @relation(fields: [poItemId], references: [id])
  quantity    Decimal            @db.Decimal(14, 3)
  unitCost    Decimal            @db.Decimal(14, 2)
  batchNumber String?
  expiryDate  DateTime?

  @@index([receiptId])
}

model StockTransfer {
  id             String   @id @default(cuid())
  salonId        String
  fromBranchId   String
  fromBranch     Branch   @relation("TransferFrom", fields: [fromBranchId], references: [id])
  toBranchId     String
  toBranch       Branch   @relation("TransferTo", fields: [toBranchId], references: [id])
  transferNumber String
  notes          String?
  createdById    String
  createdAt      DateTime @default(now())

  items StockTransferItem[]

  @@unique([salonId, transferNumber])
  @@index([salonId, createdAt])
}

model StockTransferItem {
  id         String        @id @default(cuid())
  transferId String
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId  String
  product    Product       @relation(fields: [productId], references: [id])
  quantity   Decimal       @db.Decimal(14, 3)
  unitCost   Decimal       @default(0) @db.Decimal(14, 4)

  @@index([transferId])
}

// Recipe: how much of a product one execution of a service consumes
model ServiceProduct {
  id        String   @id @default(cuid())
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Decimal  @db.Decimal(14, 3)
  createdAt DateTime @default(now())

  @@unique([serviceId, productId])
  @@index([productId])
}

// One row per booking guarantees service consumption is deducted at most once
model BookingConsumption {
  id         String    @id @default(cuid())
  bookingId  String    @unique
  booking    Booking   @relation(fields: [bookingId], references: [id])
  salonId    String
  branchId   String
  status     String // APPLIED | FAILED | REVERSED
  message    String?
  appliedAt  DateTime?
  reversedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  items BookingConsumptionItem[]

  @@index([salonId, status])
}

model BookingConsumptionItem {
  id            String             @id @default(cuid())
  consumptionId String
  consumption   BookingConsumption @relation(fields: [consumptionId], references: [id], onDelete: Cascade)
  productId     String
  product       Product            @relation(fields: [productId], references: [id])
  quantity      Decimal            @db.Decimal(14, 3)
  unitCost      Decimal            @db.Decimal(14, 4)
  totalCost     Decimal            @db.Decimal(14, 2)

  @@index([consumptionId])
}

// ---------- POS product sales ----------

model Sale {
  id             String        @id @default(cuid())
  salonId        String
  salon          Salon         @relation(fields: [salonId], references: [id])
  branchId       String
  branch         Branch        @relation(fields: [branchId], references: [id])
  saleNumber     String
  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id])
  bookingId      String?
  booking        Booking?      @relation(fields: [bookingId], references: [id])
  // Default seller (used for commission when a line has no explicit seller)
  staffId        String?
  status         SaleStatus    @default(COMPLETED)
  paymentStatus  PaymentStatus @default(UNPAID)
  subtotal       Decimal       @db.Decimal(14, 2)
  discountAmount Decimal       @default(0) @db.Decimal(14, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(14, 2)
  totalAmount    Decimal       @db.Decimal(14, 2)
  paidAmount     Decimal       @default(0) @db.Decimal(14, 2)
  refundedAmount Decimal       @default(0) @db.Decimal(14, 2)
  notes          String?
  // Client-supplied key; a retry/double-click returns the original sale
  idempotencyKey String?       @unique
  createdById    String
  voidedAt       DateTime?
  voidedById     String?
  voidReason     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  items    SaleItem[]
  payments SalePayment[]
  refunds  SaleRefund[]
  invoice  Invoice?

  @@unique([salonId, saleNumber])
  @@index([salonId, createdAt])
  @@index([branchId, createdAt])
  @@index([customerId])
  @@index([bookingId])
}

model SaleItem {
  id               String  @id @default(cuid())
  saleId           String
  sale             Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId        String
  product          Product @relation(fields: [productId], references: [id])
  // Snapshots so history is stable if the product is edited later
  productName      String
  sku              String
  quantity         Decimal @db.Decimal(14, 3)
  unitPrice        Decimal @db.Decimal(14, 2)
  discountAmount   Decimal @default(0) @db.Decimal(14, 2)
  taxRate          Decimal @default(0) @db.Decimal(5, 2)
  taxAmount        Decimal @default(0) @db.Decimal(14, 2)
  lineTotal        Decimal @db.Decimal(14, 2)
  unitCost         Decimal @default(0) @db.Decimal(14, 4)
  staffId          String?
  refundedQuantity Decimal @default(0) @db.Decimal(14, 3)

  refundItems SaleRefundItem[]

  @@index([saleId])
  @@index([productId])
}

model SalePayment {
  id        String   @id @default(cuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(14, 2)
  method    String   @default("CASH") // CASH | CARD | ONLINE | BANK
  reference String?
  createdAt DateTime @default(now())

  @@index([saleId])
}

model SaleRefund {
  id          String   @id @default(cuid())
  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  amount      Decimal  @db.Decimal(14, 2)
  method      String   @default("CASH")
  reason      String?
  createdById String
  createdAt   DateTime @default(now())

  items SaleRefundItem[]

  @@index([saleId])
}

model SaleRefundItem {
  id         String     @id @default(cuid())
  refundId   String
  refund     SaleRefund @relation(fields: [refundId], references: [id], onDelete: Cascade)
  saleItemId String
  saleItem   SaleItem   @relation(fields: [saleItemId], references: [id])
  quantity   Decimal    @db.Decimal(14, 3)
  amount     Decimal    @db.Decimal(14, 2)
  restock    Boolean    @default(true)

  @@index([refundId])
}

// ---------- Commissions ----------

// Most specific matching rule wins: staff match (4) > item match (2) > branch match (1).
// Null staffId/branchId/serviceId/productId act as wildcards.
model CommissionRule {
  id          String           @id @default(cuid())
  salonId     String
  branchId    String?
  branch      Branch?          @relation(fields: [branchId], references: [id])
  staffId     String?
  staff       Staff?           @relation(fields: [staffId], references: [id])
  source      CommissionSource
  serviceId   String?
  service     Service?         @relation(fields: [serviceId], references: [id])
  productId   String?
  product     Product?         @relation(fields: [productId], references: [id])
  type        CommissionType   @default(PERCENTAGE)
  value       Decimal          @db.Decimal(12, 4)
  isActive    Boolean          @default(true)
  createdById String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([salonId, source, isActive])
  @@index([staffId])
}

// Immutable-ish ledger: rate/base/amount are snapshots; changes are made by
// void or by adjustment entries (isAdjustment, negative amounts), never by recalculation.
model CommissionEntry {
  id               String           @id @default(cuid())
  salonId          String
  branchId         String
  branch           Branch           @relation(fields: [branchId], references: [id])
  staffId          String
  staff            Staff            @relation(fields: [staffId], references: [id])
  source           CommissionSource
  // Deterministic unique key => duplicate generation is impossible
  sourceKey        String           @unique
  bookingId        String?
  booking          Booking?         @relation(fields: [bookingId], references: [id])
  bookingServiceId String?
  saleId           String?
  saleItemId       String?
  description      String
  baseAmount       Decimal          @db.Decimal(14, 2)
  rateType         CommissionType
  rateValue        Decimal          @db.Decimal(12, 4)
  amount           Decimal          @db.Decimal(14, 2)
  status           CommissionStatus @default(PENDING)
  earnedAt         DateTime
  ruleId           String?
  isAdjustment     Boolean          @default(false)
  adjustsEntryId   String?
  notes            String?
  approvedById     String?
  approvedAt       DateTime?
  paidAt           DateTime?
  voidedAt         DateTime?
  voidReason       String?
  payrollRecordId  String?
  payrollRecord    PayrollRecord?   @relation(fields: [payrollRecordId], references: [id])
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([salonId, earnedAt])
  @@index([staffId, status])
  @@index([branchId, earnedAt])
  @@index([payrollRecordId])
  @@index([bookingId])
  @@index([saleId])
}

// ---------- Payroll ----------

model StaffCompensation {
  id                  String     @id @default(cuid())
  salonId             String
  staffId             String     @unique
  staff               Staff      @relation(fields: [staffId], references: [id])
  salaryType          SalaryType @default(FIXED_MONTHLY)
  // monthly salary | daily rate | hourly rate depending on salaryType
  baseAmount          Decimal    @default(0) @db.Decimal(14, 2)
  overtimeEnabled     Boolean    @default(false)
  overtimeRate        Decimal    @default(0) @db.Decimal(14, 2) // per overtime hour
  standardHoursPerDay Decimal    @default(8) @db.Decimal(5, 2)
  isActive            Boolean    @default(true)
  notes               String?
  updatedById         String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@index([salonId])
}

model StaffAdvance {
  id                String        @id @default(cuid())
  salonId           String
  branchId          String?
  staffId           String
  staff             Staff         @relation(fields: [staffId], references: [id])
  amount            Decimal       @db.Decimal(14, 2)
  advanceDate       DateTime
  reason            String?
  // Optional per-month recovery cap; null = recover the outstanding balance at once
  installmentAmount Decimal?      @db.Decimal(14, 2)
  recoveredAmount   Decimal       @default(0) @db.Decimal(14, 2)
  status            AdvanceStatus @default(OUTSTANDING)
  createdById       String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  recoveries PayrollAdvanceRecovery[]

  @@index([salonId, status])
  @@index([staffId, status])
}

model PayrollPeriod {
  id         String       @id @default(cuid())
  salonId    String
  year       Int
  month      Int
  status     PeriodStatus @default(OPEN)
  closedAt   DateTime?
  closedById String?
  createdAt  DateTime     @default(now())

  @@unique([salonId, year, month])
}

// NOTE: a partial unique index (staffId, periodYear, periodMonth) WHERE status <> 'VOIDED'
// is created in the migration SQL to prevent duplicate payroll for a staff member+period.
model PayrollRecord {
  id            String   @id @default(cuid())
  salonId       String
  branchId      String
  branch        Branch   @relation(fields: [branchId], references: [id])
  staffId       String
  staff         Staff    @relation(fields: [staffId], references: [id])
  payslipNumber String
  periodYear    Int
  periodMonth   Int
  periodStart   DateTime
  periodEnd     DateTime

  // Snapshot of terms used for this calculation
  staffName     String
  salaryType    SalaryType
  baseRate      Decimal    @db.Decimal(14, 2)
  daysWorked    Decimal    @default(0) @db.Decimal(7, 2)
  hoursWorked   Decimal    @default(0) @db.Decimal(8, 2)
  overtimeHours Decimal    @default(0) @db.Decimal(8, 2)

  basicAmount      Decimal @default(0) @db.Decimal(14, 2)
  overtimeAmount   Decimal @default(0) @db.Decimal(14, 2)
  commissionAmount Decimal @default(0) @db.Decimal(14, 2)
  bonusAmount      Decimal @default(0) @db.Decimal(14, 2)
  deductionAmount  Decimal @default(0) @db.Decimal(14, 2)
  advanceDeduction Decimal @default(0) @db.Decimal(14, 2)
  grossAmount      Decimal @default(0) @db.Decimal(14, 2)
  netAmount        Decimal @default(0) @db.Decimal(14, 2)
  calculation      Json?

  status           PayrollStatus @default(DRAFT)
  notes            String?
  generatedById    String
  approvedById     String?
  approvedAt       DateTime?
  paidById         String?
  paidAt           DateTime?
  paymentMethod    String?
  paymentReference String?
  voidedById       String?
  voidedAt         DateTime?
  voidReason       String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  adjustments       PayrollAdjustment[]
  advanceRecoveries PayrollAdvanceRecovery[]
  commissions       CommissionEntry[]

  @@unique([salonId, payslipNumber])
  @@index([salonId, periodYear, periodMonth])
  @@index([branchId, periodYear, periodMonth])
  @@index([staffId])
}

model PayrollAdjustment {
  id              String                @id @default(cuid())
  payrollRecordId String
  payrollRecord   PayrollRecord         @relation(fields: [payrollRecordId], references: [id], onDelete: Cascade)
  type            PayrollAdjustmentType
  amount          Decimal               @db.Decimal(14, 2)
  reason          String
  createdById     String
  createdAt       DateTime              @default(now())

  @@index([payrollRecordId])
}

model PayrollAdvanceRecovery {
  id              String        @id @default(cuid())
  payrollRecordId String
  payrollRecord   PayrollRecord @relation(fields: [payrollRecordId], references: [id], onDelete: Cascade)
  advanceId       String
  advance         StaffAdvance  @relation(fields: [advanceId], references: [id])
  amount          Decimal       @db.Decimal(14, 2)
  // Becomes true when the payroll is paid (advance.recoveredAmount is then incremented)
  applied         Boolean       @default(false)

  @@index([payrollRecordId])
  @@index([advanceId])
}
